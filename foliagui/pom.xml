<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.spirtysprite</groupId>
        <artifactId>folia-libs-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.foliagui</groupId>
    <artifactId>foliagui-api</artifactId>
    <version>1.3.1</version>
    <packaging>jar</packaging>

    <name>FoliaGUI-API</name>
    <description>A complete, thread-safe inventory GUI API for Folia (and Paper). Pure library: no commands, no plugin.yml.</description>

    <properties>
        <coverage.minimum>0.50</coverage.minimum>
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <junit.version>6.0.3</junit.version>
        <mockbukkit.version>4.116.3</mockbukkit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.foliacommons</groupId>
            <artifactId>folia-commons</artifactId>
            <version>${folia-commons.version}</version>
        </dependency>
        <!-- Paper API bundles the Folia region-scheduler interfaces + Adventure. Provided at runtime. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test-only: a fake Bukkit server so GUI code (item meta, inventories, click events) can run
             in a plain unit test without a real Paper server. -->
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>${mockbukkit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <!-- foliagui-version.properties has its ${project.version} placeholder substituted at build
                 time, so FoliaGUI.VERSION reflects the real POM version instead of a hand-maintained constant. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Each test class that mocks its own server needs a fresh JVM rather than a shared one. -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
