<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.spirtysprite</groupId>
        <artifactId>folia-libs-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>net.folianpc</groupId>
    <artifactId>folianpc</artifactId>
    <version>1.4.0</version>
    <packaging>jar</packaging>

    <name>FoliaNPC</name>
    <description>Folia-native, packet-level NPC library for Paper/Folia 1.20.6+.</description>

    <properties>
        <coverage.minimum>0.37</coverage.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.foliacommons</groupId>
            <artifactId>folia-commons</artifactId>
            <version>${folia-commons.version}</version>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Only used to inject a netty handler for reading interact packets; the server ships it. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.97.Final</version>
            <scope>provided</scope>
        </dependency>
        <!-- Parsing Mojang's skin API responses; the server bundles Gson. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <!-- The *-version.properties file has its ${project.version} placeholder filled in at build
                 time, so VERSION always reflects the real pom version. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
